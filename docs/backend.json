
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Store user specific preferences and links to habits.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Habit": {
      "title": "Habit Tracker",
      "description": "A habit being tracked by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "resetDates": { "type": "array", "items": { "type": "string", "format": "date-time" } },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "Habits associated with the user"
    }
  }
}
